# Copy this file to .env.local and fill in real values.
# See README.md for setup steps.

# --- Database (Neon Postgres) ---
# Use Neon's pooled connection string (Postgres-wire-compatible with @payloadcms/db-postgres).
DATABASE_URI=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Payload CMS ---
# Internal signing secret for Payload (any long random string). Not a third-party credential.
PAYLOAD_SECRET=

# Public URL this app is served from (used by Payload for absolute links, cookies, etc.)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Resend (transactional email) ---
RESEND_API_KEY=

# Internal address that receives best-effort notifications for new
# consultation requests (weddings/spa/general enquiries). Leave empty to
# skip internal notifications (the ConsultationRequests record is still
# created either way — see app/api/consultations/route.ts).
STAFF_NOTIFICATION_EMAIL=

# --- Razorpay (primary payment gateway) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Stripe (secondary payment gateway) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
